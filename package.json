{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && tsx scripts/prerender.ts",
    "seo:prerender": "tsx scripts/prerender.ts",
    "start": "tsx server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-ssr server.js",
    "lint": "tsc --noEmit",
    "lint:security": "eslint src server.ts",
    "test:unit": "tsx --test src/services/*.test.ts src/utils/*.test.ts",
    "test:e2e": "playwright test",
    "loadtest": "k6 run load-tests/k6-plan.js"
  },
  "dependencies": {
    "@eslint/js": "10.0.1",
    "@sentry/react": "11.18.0",
    "@supabase/supabase-js": "2.119.2",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/react-query": "5.108.4",
    "@vitejs/plugin-react": "6.3.0",
    "dompurify": "3.5.0",
    "dotenv": "18.0.10",
    "eslint": "10.15.0",
    "eslint-plugin-security": "4.2.1",
    "express": "5.3.0",
    "lucide-react": "1.81.0",
    "motion": "14.14.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.7",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.11",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "overrides": {
    "esbuild": "0.28.2"
  }
}
