{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && tsx scripts/prerender.ts",
    "seo:prerender": "tsx scripts/prerender.ts",
    "start": "tsx server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-ssr server.js",
    "lint": "tsc --noEmit",
    "lint:security": "eslint src server.ts",
    "test:unit": "tsx --test src/services/*.test.ts src/utils/*.test.ts",
    "test:e2e": "playwright test",
    "loadtest": "k6 run load-tests/k6-plan.js"
  },
  "dependencies": {
    "@eslint/js": "10.0.1",
    "@sentry/react": "^11.17.0",
    "@supabase/supabase-js": "2.119.2",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.108.3",
    "@types/dompurify": "3.0.5",
    "@vitejs/plugin-react": "6.1.1",
    "dompurify": "3.5.0",
    "dotenv": "17.2.3",
    "eslint": "10.15.0",
    "eslint-plugin-security": "4.2.1",
    "express": "^4.22.3",
    "lucide-react": "0.546.0",
    "motion": "12.23.24",
    "react": "19.0.1",
    "react-dom": "19.0.1",
    "react-router-dom": "7.18.6",
    "typescript-eslint": "8.73.0",
    "vite": "^8.3.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.14.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.4.21",
    "esbuild": "^0.28.2",
    "tailwindcss": "4.3.3",
    "tsx": "4.21.0",
    "typescript": "5.8.3",
    "@types/express": "4.17.21"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  }
}
