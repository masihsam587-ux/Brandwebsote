# ==============================================================================
# PUBLIC CLIENT ENVIRONMENT VARIABLES (Safe to bundle with Vite browser build)
# Only VITE_* variables are exposed to frontend JavaScript.
# ==============================================================================

# Backend adapter switch: mock | rest | supabase
VITE_BACKEND="supabase"

# REST API origin when VITE_BACKEND="rest" (empty = same-origin /api)
VITE_API_BASE_URL=""

# Canonical public domain used for sitemaps, hreflang, and pre-rendered HTML
VITE_SITE_URL="https://cinematicartstore.netlify.app"

# Supabase Public Project URL & Public Anonymous Key (RLS enforces security)
# SAFE TO EXPOSE: Never put SUPABASE_SERVICE_ROLE_KEY in VITE_*!
VITE_SUPABASE_URL="https://wqbdpaxcmrrsxehcvdna.supabase.co"
VITE_SUPABASE_ANON_KEY="sb_publishable__nqJ-wQOuLakzxthcYSEdw_rkI37k2u"

# Optional Cloudflare Turnstile Site Key (public widget key; secret stays server-side)
VITE_TURNSTILE_SITE_KEY=""

# ==============================================================================
# SEARCH ENGINE VERIFICATION & PRIVACY-FRIENDLY ANALYTICS (Optional Placeholders)
# ==============================================================================
# Google Search Console HTML tag token (content="..." value only)
VITE_GSC_VERIFICATION=""
# Bing Webmaster Tools verification token (msvalidate.01 content="..." value only)
VITE_BING_VERIFICATION=""
# Privacy-friendly analytics (Plausible domain OR Umami website ID + script URL)
VITE_PLAUSIBLE_DOMAIN=""
VITE_UMAMI_WEBSITE_ID=""
VITE_UMAMI_SCRIPT_URL=""

# Error tracking (Sentry browser DSN placeholder; strictly zero PII sent)
VITE_SENTRY_DSN=""
VITE_SENTRY_ENVIRONMENT="production"

# ==============================================================================
# SERVER-ONLY SECRETS & SEO REBUILD CONTROLS (NEVER prefix with VITE_)
# ==============================================================================
APP_URL="https://cinematicartstore.netlify.app"
SITE_URL="https://cinematicartstore.netlify.app"
PORT="3000"
CORS_ORIGIN=""

# Toggle AI crawlers in robots.txt ("true" = allow GPTBot/ClaudeBot/PerplexityBot; "false" = block AI bots)
AI_CRAWLERS_ALLOW="true"

# Shared secret for triggering /api/seo/rebuild or /api/seo/webhook/supabase when Supabase products change
SEO_REBUILD_SECRET=""

# Admin Auth & Signing Secrets (server-side only)
ADMIN_PASSWORD=""
ADMIN_TOKEN_SECRET=""
USER_TOKEN_SECRET=""
CSRF_SECRET=""

# Database & Third-Party Server Secrets (server-side only)
DATABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
TURNSTILE_SECRET_KEY=""
